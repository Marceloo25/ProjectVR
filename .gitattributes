# Enforce consistent line endings in this repo.
# Keep text files as LF on all platforms.
* text=auto eol=lf

# Common Unity / .NET text formats
*.cs     text eol=lf
*.csproj text eol=lf
*.sln    text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.shader text eol=lf
*.cginc  text eol=lf
*.hlsl   text eol=lf
*.asmdef text eol=lf
*.meta   text eol=lf
*.prefab text eol=lf
*.unity  text eol=lf
*.asset  text eol=lf

# Treat common binary assets as binary (no line-ending conversion)
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.gif  binary
*.bmp  binary
*.hdr  binary
*.exr  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.mov  binary
*.dll  binary
*.exe  binary
*.pdb  binary
*.zip  binary
*.rar  binary
